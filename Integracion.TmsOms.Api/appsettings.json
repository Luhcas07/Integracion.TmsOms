{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Tms": {
    "ApiKey": "dev-secret-key",
    "SourceUtcOffsetHours": -5
  },
  "Queue": {
    "MaxDeliveryCount": 5,
    "LockDurationSeconds": 30,
    "RedeliveryDelayMilliseconds": 500
  },
  "Retry": {
    "MaxAttempts": 3,
    "InitialDelayMilliseconds": 200
  },
  "Workers": {
    "PollIntervalMilliseconds": 100
  },
  "Evidence": {
    "MaxSizeBytes": 5242880
  },
  "CircuitBreaker": {
    "FailureThreshold": 3,
    "OpenDurationSeconds": 10
  },
  "Clients": {
    "01021755": {
      "Format": "standard-v1",
      "Destination": "https://api.tiendasperuanas.example/tracking"
    },
    "02034411": {
      "Format": "legacy-v1",
      "Destination": "https://integraciones.supermercadosdelsur.example/estado",
      "NotifyStatuses": [ "Started", "Delivered", "NotDelivered", "ToBeReturn", "Returned" ]
    }
  }
}